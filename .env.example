# SQLite database file path (the .db file is gitignored — each environment has its own)
DATABASE_URL=file:./clientname.db
# Set false for databases managed through migrations (including the sandbox preview).
PAYLOAD_SCHEMA_PUSH=

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Stripe server credentials. Start with test mode; never use NEXT_PUBLIC_ for secrets.
STRIPE_SECRET_KEY=
# Optional; stored for future embedded integrations, unused by hosted Checkout.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Enable Stripe's no-code customer portal and paste its email-login URL here.
STRIPE_CUSTOMER_PORTAL_URL=
# Enable only after configuring Stripe Tax registrations/settings.
STRIPE_AUTOMATIC_TAX=false
